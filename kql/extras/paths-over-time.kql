// Optional: share of each connection path over time, as a column chart.
// Handy when you change something (egress, host pool switches, client rollout) and want
// to see the effect per 15-minute window. Same buckets as kql/session-classification.kql
// (part 6 of the blog series "AVD connection paths").
let lookback = 1d;
let connections = WVDConnections
    | where TimeGenerated > ago(lookback)
    // | where _ResourceId has "<your-host-pool-name>"   // optional: limit to one host pool
    | summarize
        Started = minif(TimeGenerated, State == "Started"),
        FinalTransport = take_anyif(TransportType, State == "Completed")
        by CorrelationId;
let shortpath = WVDCheckpoints
    | where TimeGenerated > ago(lookback)
    | where Name in ("ShortpathEstablished", "ShortpathFallbackToGatewayTransport", "ShortpathPublicLocalCandidatesReady")
    | summarize
        UdpType = take_anyif(tostring(Parameters.initialUdpType), Name == "ShortpathEstablished"),
        FallbackReason = take_anyif(tostring(Parameters.FallbackReason), Name == "ShortpathFallbackToGatewayTransport"),
        CandidateRows = countif(Name == "ShortpathPublicLocalCandidatesReady")
        by CorrelationId;
connections
| join kind=leftouter shortpath on CorrelationId
| extend Path = case(
    UdpType == "ShortpathPrivate" or FinalTransport == "ShortpathPrivate", "UDP private (listener)",
    UdpType == "Shortpath_Relayed_UDP" or FinalTransport == "TURN Relay", "UDP via TURN relay",
    UdpType in ("Shortpath_Direct_UDP", "Shortpath_UDP_over_NAT") or FinalTransport == "ShortpathPublic", "UDP direct (STUN or private ICE)",
    FallbackReason == "NotSupported", "TCP: client did not offer UDP",
    UdpType == "Unknown" or FinalTransport == "Multipath", "Unclear (Multipath, check the session host)",
    CandidateRows > 0 and isempty(UdpType), "TCP: candidates ready, UDP never came up",
    isempty(FinalTransport), "Still running or no data",
    "TCP")
| where isnotnull(Started)
| summarize Sessions = count() by Path, bin(Started, 15m)
| render columnchart
